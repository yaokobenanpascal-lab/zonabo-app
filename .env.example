# Copie ce fichier en ".env" en local (jamais en ligne — ces valeurs se règlent
# comme "variables d'environnement" dans le tableau de bord de ton hébergeur).

# Fournie automatiquement par ton hébergeur si tu utilises son PostgreSQL managé
# (Render, Railway, Supabase, Neon...). Sinon, format :
# postgres://utilisateur:motdepasse@hote:5432/nom_de_la_base
DATABASE_URL=postgres://user:password@localhost:5432/zonako

# Le code que TOI seul dois connaître pour accéder à l'espace propriétaire.
# Choisis quelque chose de solide (pas "zonako2026" !). Ne le mets jamais dans le code.
OWNER_PASSCODE=change-moi

# Identifiants marchand CinetPay (nouvelle API "Aurore" v1 — Espace CinetPay >
# API & Sécurité) — le serveur initie ET vérifie maintenant chaque paiement
# lui-même (plus de guichet JavaScript côté frontend).
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Optionnel — Sandbox par défaut si non défini. À remplacer par l'URL de
# production une fois confirmée par CinetPay.
CINETPAY_BASE_URL=https://api.cinetpay.net

# Africa's Talking (SMS) — priorité sur Twilio pour les codes de vérification
# par téléphone ET les notifications de commande, mieux adapté au marché
# ivoirien. Crée un compte sur africastalking.com, une "App", récupère la clé
# API depuis Settings > API Key.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Twilio Verify (SMS OTP) — utilisé seulement si Africa's Talking n'est pas
# configuré. Sans aucun des deux, les codes de vérification s'affichent dans
# les logs du serveur au lieu d'être envoyés par SMS (pratique pour tester
# gratuitement avant de payer pour de vrais SMS).
# Crée un compte sur twilio.com, active "Verify", crée un "Verify Service".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Facultatif : un numéro Twilio (acheté séparément, quelques dollars/mois) pour
# envoyer des notifications SMS libres (ex: "ta commande a été confirmée") si
# Africa's Talking n'est pas configuré. Sans rien de tout ça, les
# notifications sont simplement ignorées (pas d'erreur).
TWILIO_FROM_NUMBER=

# Connexion par email (en plus du téléphone) — utilise l'API HTTP de Brevo
# (pas le SMTP classique : Render bloque les ports SMTP sur le plan gratuit
# depuis septembre 2025). Sans ça, les codes email s'affichent dans les logs.
# Clé API : sur app.brevo.com → Transactionnel → Email → Paramètres de l'API.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Port d'écoute (la plupart des hébergeurs le définissent automatiquement, ignore-le si c'est le cas)
PORT=3000
